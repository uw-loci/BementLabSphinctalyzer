#!/bin/bash
# Double-click to start Sphinctalyzer v{{VERSION}} ({{PLATFORM}}).
# Generated by build/buildStandalone.m; keep this file in the folder with the app.
#
# The app needs the MATLAB Runtime R2023b. If it is installed somewhere other
# than /Applications/MATLAB/MATLAB_Runtime/R2023b, set MCR_ROOT to its folder.

APP_ARCH="{{ARCH}}"            # maci64 (Intel) or maca64 (M-series)
RUN_SCRIPT="{{RUN_SCRIPT}}"    # written by MATLAB Compiler
APP_BUNDLE="{{APP_BUNDLE}}"
RUNTIME_DOWNLOAD="{{RUNTIME_URL}}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

finish() {
    # keep the Terminal window open so the message can be read
    echo
    read -n 1 -s -r -p "Press any key to close this window."
    echo
    exit "$1"
}

echo "Starting Sphinctalyzer v{{VERSION}} ({{PLATFORM}})..."

# MATLAB Runtime
MCR_DIR=""
for candidate in "$MCR_ROOT" "/Applications/MATLAB/MATLAB_Runtime/R2023b" "/Applications/MATLAB/MATLAB_Runtime/v923"; do
    if [ -n "$candidate" ] && [ -d "$candidate/runtime/$APP_ARCH" ]; then
        MCR_DIR="$candidate"
        break
    fi
done
if [ -z "$MCR_DIR" ]; then
    echo
    echo "The MATLAB Runtime R2023b ($APP_ARCH) was not found."
    echo "Install it from:"
    echo "  $RUNTIME_DOWNLOAD"
    echo "If it is installed in another folder, start this script with MCR_ROOT set to that folder."
    finish 1
fi

# this package must match the Mac's processor
MACHINE="$(uname -m)"
if [ "$APP_ARCH" = "maca64" ] && [ "$MACHINE" != "arm64" ]; then
    echo
    echo "This package is for Macs with M-series (Apple silicon) processors."
    echo "Download the Mac (Intel) package for this Mac."
    finish 1
fi
if [ "$APP_ARCH" = "maci64" ] && [ "$MACHINE" = "arm64" ] && ! /usr/bin/arch -x86_64 /usr/bin/true 2>/dev/null; then
    echo
    echo "This Intel package needs Rosetta on an M-series Mac. Install it with:"
    echo "  softwareupdate --install-rosetta"
    echo "or download the Mac M-series package instead."
    finish 1
fi

# avoid library conflicts with an active conda environment
if command -v conda &> /dev/null; then
    eval "$(conda shell.bash hook)"
    conda deactivate
fi

# a downloaded app is quarantined by macOS; allow this app to start
xattr -dr com.apple.quarantine "$SCRIPT_DIR/$APP_BUNDLE" 2>/dev/null

cd "$SCRIPT_DIR" || { echo "Error: cannot access $SCRIPT_DIR"; finish 1; }

# keep a log of the app's console output (useful when reporting a problem)
LOG_DIR="$HOME/Library/Logs/Sphinctalyzer"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/Sphinctalyzer_v{{VERSION}}_$(date +%Y%m%d_%H%M%S).log"
echo "Log: $LOG_FILE"

"./$RUN_SCRIPT" "$MCR_DIR" 2>&1 | tee "$LOG_FILE"
status=${PIPESTATUS[0]}
if [ "$status" -ne 0 ]; then
    echo
    echo "Sphinctalyzer stopped with an error (exit code $status)."
    echo "The log is saved in: $LOG_FILE"
    finish "$status"
fi
